# Copy this file to .env and set your real keys here.
OPENROUTER_API_KEY=sk-your-openrouter-key-here
OPENROUTER_MODEL=gpt-4o-mini
# Optional Google Gemini key if you want to use Gemini instead of OpenRouter
GEMINI_API_KEY=your-gemini-key-here

# Optional Postgres connection string (Neon/Supabase). Leave unset to use the
# local SQLite file (smartml.db) for local development.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
