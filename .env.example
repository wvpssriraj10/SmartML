# Copy this file to .env and set your real keys here.
OPENROUTER_API_KEY=sk-your-openrouter-key-here
OPENROUTER_MODEL=gpt-4o-mini
# Optional Google Gemini key (used for AI Insights narratives + chat fallback)
GEMINI_API_KEY=your-gemini-key-here

# CORS: comma-separated list of allowed frontend origins in production.
# Leave unset (or blank) for local dev — falls back to wildcard with no credentials.
# Example: ALLOWED_ORIGINS=https://your-app.onrender.com,https://smartml.yourdomain.com
# ALLOWED_ORIGINS=

# Optional Postgres connection string (Neon/Supabase). Leave unset to use the
# local SQLite file (smartml.db) for local development.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional Supabase storage for large file uploads (avoids server memory limits).
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-supabase-anon-or-service-key
# SUPABASE_BUCKET=uploads
